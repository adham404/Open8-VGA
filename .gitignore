kicad/**/.history/
*.lck
*.kicad_prl
fp-info-cache
*-backups/
_autosave-*

# Local tools and scratch: the Freerouting download, the raw HeyPCB export
tools/freerouting/
kicad/heypcb_export/

# Editor / OS
.claude/
.DS_Store
.vscode/
.idea/
